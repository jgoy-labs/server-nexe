# ────────────────────────────────────────────────────────
# server-nexe — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ────────────────────────────────────────────────────────

# --- Required secrets ---
NEXE_PRIMARY_API_KEY=<generate-with-python-secrets-token-hex-32>
NEXE_CSRF_SECRET=<generate-with-python-secrets-token-hex-32>
# Optional: IPs addicionals autoritzades per al bootstrap (coma-separades)
# NEXE_VPN_ALLOWED_IPS=10.0.0.1,192.168.1.100

# --- Environment ---
NEXE_ENV=production
NEXE_LOG_LEVEL=INFO
NEXE_LANG=ca

# --- Modules ---
NEXE_APPROVED_MODULES=security,llama_cpp_module,mlx_module,ollama_module,web_ui_module

# --- Model ---
NEXE_DEFAULT_MODEL=https://huggingface.co/microsoft/Phi-3.5-mini-instruct-gguf/resolve/main/Phi-3.5-mini-instruct-Q4_K_M.gguf
NEXE_MODEL_ENGINE=llama_cpp
NEXE_LLAMA_CPP_MODEL=storage/models/Phi-3.5-mini-instruct-Q4_K_M.gguf

# --- Qdrant (embedded mode by default) ---
NEXE_QDRANT_PATH=storage/vectors
# Optional: external Qdrant override (Docker, cluster, Qdrant Cloud)
# NEXE_QDRANT_URL=http://localhost:6333
# Optional: set if Qdrant is deployed with authentication enabled
# QDRANT_API_KEY=<generate-with-python-secrets-token-hex-32>

# --- Ollama ---
NEXE_OLLAMA_HOST=http://localhost:11434
NEXE_OLLAMA_MODEL=llama3.2
# Embedding model per Qdrant RAG (requereix Ollama)
# NEXE_OLLAMA_EMBED_MODEL=nomic-embed-text
# NEXE_OLLAMA_EMBED_TIMEOUT=30.0
# NEXE_OLLAMA_CHAT_TIMEOUT=30.0
# NEXE_OLLAMA_NUM_CTX=8192          # context window sent to Ollama (default: auto from RAM)
# Reply ceiling in tokens for the web and the app (default 2048), the mirror of
# NEXE_MLX_MAX_TOKENS and NEXE_LLAMA_CPP_MAX_TOKENS. A reply that hits it can
# offer Continue, for the families measured to resume. /v1 is not this knob:
# it already sends num_predict from the request or NEXE_DEFAULT_MAX_TOKENS.
# NEXE_OLLAMA_MAX_TOKENS=2048
# NEXE_OLLAMA_PULL_TIMEOUT=600.0
# Optional: Desactivar inici automàtic d'Ollama al startup
# NEXE_AUTOSTART_OLLAMA=true

# --- Context window and compaction (#965) ---
# By default the prompt budget (70% of the window) and the compaction threshold
# (45% of the window) are sized from the serving engine's real context window —
# the window itself comes from NEXE_OLLAMA_NUM_CTX, NEXE_LLAMA_CPP_N_CTX or
# NEXE_MLX_MAX_KV_SIZE (each engine's section in this file), auto-detected when unset.
# BEST LEFT UNSET: any fixed number here is wrong for some engine. A threshold
# that suits an 8192-token window overflows a 2048/4096 one (llama.cpp answers
# an oversized prompt with an error, not a truncation). And the two knobs are
# coupled: the budget must cover the system prompt (~4700 chars) plus 4x the
# compaction threshold plus the message plus ~500 chars of response buffer, or
# RAG and attached documents are silently squeezed out of the prompt. Override
# them TOGETHER or not at all: fixing only MAX_CONTEXT_CHARS on a machine whose
# window is larger than 8192 lets the auto threshold outgrow the fixed budget
# (24000 alone at a 32768-token window leaves the budget tens of thousands of
# chars short). The example pair below is sized for a window of ~8192 tokens
# and is safe together at any window.
# NEXE_MAX_CONTEXT_CHARS=24000     # chars the whole prompt may occupy (default: 70% of the window)
# NEXE_COMPACT_AT_TOKENS=2000      # history tokens above which the chat summarises (default: 45% of the window)
# NEXE_DEFAULT_CONTEXT_WINDOW=8192 # fallback window used when no live engine can report one
# NEXE_HISTORY_CONTEXT_RATIO=0.30  # /ui/chat ONLY (/v1 has no attached documents and passes 0):
#                                  # floor of the budget kept for the history, so a big document
#                                  # cannot wipe out previous turns (default: 0.30). Raising it
#                                  # takes room from the retrieved context: at a 8192-token window
#                                  # 0.9 leaves nothing for it even with an empty conversation.
#                                  # Out-of-range or non-numeric values keep the default (#977).

# --- MLX (Apple Silicon) ---
# NEXE_MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
# NEXE_MLX_MAX_KV_SIZE=32768        # KV window (default: auto from RAM, model weights and the model's own
#                                   # limit, never below 8192; setting this SKIPS the model cap entirely)

# --- Llama.cpp ---
# NEXE_LLAMA_CPP_GPU_LAYERS=0
# NEXE_LLAMA_CPP_N_CTX=4096
# NEXE_LLAMA_CPP_THREADS=4
# NEXE_LLAMA_CPP_N_BATCH=512
# NEXE_LLAMA_CPP_MAX_SESSIONS=1
# Reply ceiling in tokens (default 2048), the mirror of NEXE_MLX_MAX_TOKENS.
# Raise it if a reasoning model runs out of room before it answers: llama.cpp
# offers no way to turn reasoning off, so this is the only lever it has.
# NEXE_LLAMA_CPP_MAX_TOKENS=2048
# NEXE_LLAMA_CPP_CHAT_FORMAT=chatml
# NEXE_LLAMA_CPP_USE_MLOCK=true
# NEXE_LLAMA_CPP_USE_MMAP=true
# NEXE_LLAMA_CPP_FLASH_ATTN=true

# --- Inference ---
# Default max tokens for generation (num_predict). Thinking models may need 8192+.
# NEXE_DEFAULT_MAX_TOKENS=4096
# Streaming timeout for thinking models (seconds)
# NEXE_OLLAMA_STREAM_TIMEOUT=300

# --- Prompt ---
NEXE_PROMPT_TIER=full

# --- Server URL (for CLI and web_ui) ---
NEXE_API_BASE_URL=http://127.0.0.1:9119

# --- Security ---
# NEXE_ADMIN_API_KEY=<generate-with-python-secrets-token-hex-32>
NEXE_DEV_MODE=false
# Optional: IPs extra acceptades com a client per al bootstrap endpoint. S'AFEGEIXEN
# als de sempre (127.0.0.1, ::1, localhost), que mai es perden.
# NEXE_LOCALHOST_ALIASES=host.docker.internal,mylocal
# Optional: noms extra acceptats a la capçalera Host (TrustedHostMiddleware).
# S'AFEGEIXEN als de sempre (127.0.0.1, ::1, localhost), que mai es perden.
# NEXE_TRUSTED_HOSTS=host.docker.internal,mylocal
# Optional: cal per arrencar amb un bind fora de loopback (sense això, el servidor
# es nega a arrencar). Els binds IPv6 es refusen igualment: el filtre de Host no
# pot casar una adreça IPv6 entre claudàtors — feu servir 127.0.0.1.
# NEXE_ALLOW_PUBLIC_BIND=1
# Optional: Rotació de claus API (dual-key)
# NEXE_PRIMARY_KEY_EXPIRES=2027-01-01T00:00:00Z
# NEXE_PRIMARY_KEY_CREATED=2026-01-01T00:00:00Z
# NEXE_SECONDARY_API_KEY=<clau-en-periode-de-gracia>
# NEXE_SECONDARY_KEY_EXPIRES=2026-06-01T00:00:00Z
# NEXE_SECONDARY_KEY_CREATED=2025-06-01T00:00:00Z

# --- Rate Limiting ---
# NEXE_RATE_LIMIT_CHAT=60/minute
# NEXE_RATE_LIMIT_MEMORY=30/minute
# NEXE_RATE_LIMIT_RAG=30/minute
# NEXE_RATE_LIMIT_UPLOAD=10/minute
# NEXE_RATE_LIMIT_DEFAULT=120/minute
# NEXE_RATE_LIMIT_GLOBAL=100/minute
# NEXE_RATE_LIMIT_HEALTH=1000/minute

# --- Bootstrap ---
NEXE_BOOTSTRAP_DISPLAY=true
NEXE_BOOTSTRAP_TTL=30

# --- Timeouts (seconds) ---
NEXE_QDRANT_TIMEOUT=5.0
NEXE_SQLITE_PRELOAD_TIMEOUT=10.0
NEXE_OLLAMA_HEALTH_TIMEOUT=5.0
NEXE_OLLAMA_UNLOAD_TIMEOUT=10.0
# NEXE_CLI_HEALTH_TIMEOUT=5.0

# --- Ollama native compatibility ---
# OLLAMA_HOST=localhost  # Suportat com a fallback de NEXE_OLLAMA_HOST
