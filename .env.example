# Example environment for a Tauri v2 app with optional Python sidecar.
# Copy to `.env` and edit (`.env` is gitignored).

# =============================================================================
# ACTIVE — wired at runtime (see src-tauri/src/lib.rs)
# =============================================================================

# Rust tracing level (info | debug | warn | error | trace)
RUST_LOG=info

# =============================================================================
# PLANNED — TODO: wire at runtime when adding a sidecar
# =============================================================================

# Mode (how the sidecar is launched):
#   dev     = sidecar arrencada externament (p.ex. `python -m my_sidecar`)
#   release = Tauri fa spawn del sidecar empaquetat al bundle
# SIDECAR_MODE=dev

# Sidecar HTTP/WS
# SIDECAR_URL=http://127.0.0.1:8000
# SIDECAR_PORT=8000
# SIDECAR_HEALTH_TIMEOUT=30

# Override d'app_data_dir() (only if you know what you're doing):
#   macOS default: ~/Library/Application Support/<your-app>
#   Linux default: ~/.local/share/<your-app>
# APP_HOME=
