<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    Entitlements mínims per a hardened runtime Tauri v2.
    Referència: https://tauri.app/distribute/sign/macos/

    F025: allow-unsigned-executable-memory NO necessari per WKWebView 13+.
    Desactivat per reduir superfície i preservar hardened runtime complet.

    F026: files.user-selected.read-write desactivat per defecte (least privilege).
    Activar quan s'implementi un file picker explícit (Fase futura).

    F027: App Sandbox (com.apple.security.app-sandbox) deliberadament absent.
    El sidecar Python (server-nexe) requereix accés al FS i xarxa localhost
    que trenca la sandboxing d'App Sandbox. Decisió documentada a SECURITY.md.
    Mitigació: canonicalize + path traversal checks + CSP + rate limiting.
    -->

    <!-- Necessaris per apps Tauri/WebKit amb hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- F025: false per WKWebView 13+ (no requerit des de macOS 13.0) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>

    <!-- Xarxa sortint (connexió al sidecar server-nexe via localhost) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Xarxa entrant — desactivat fins que el sidecar necessiti servidor -->
    <!--
    <key>com.apple.security.network.server</key>
    <true/>
    -->

    <!-- F026: accés fitxers desactivat per defecte (least privilege).
        Activar quan s'afegeixi file picker explícit a la UI. -->
    <!--
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    -->

    <!-- Deshabilitat. Activar si el sidecar necessita dylibs no signades -->
    <!--
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    -->
</dict>
</plist>
