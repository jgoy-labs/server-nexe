{
 "_meta": {
  "component": "registry",
  "description": "Translations for the central module registry",
  "version": "1.0.0",
  "language": "en-US"
 },

 "registration": {
  "module_registered": "Module '{name}' registered with the system",
  "module_unregistered": "Module '{name}' unregistered from the system",
  "already_registered": "Module '{name}' is already registered",
  "registration_failed": "Error registering module '{name}': {error}",
  "metadata_extracted": "Metadata extracted from the manifest for {module}"
 },

 "endpoints": {
  "discovered": "Endpoint discovered: {method} {path} ({module})",
  "indexed": "{count} endpoints indexed for {module}",
  "router_found": "FastAPI router found for {module}",
  "no_router": "No router found for {module}",
  "endpoint_registered": "Endpoint registered: {method} {path}",
  "endpoint_removed": "Endpoint removed: {method} {path}"
 },

 "manifest": {
  "processing": "Processing manifest for {module}",
  "api_config_found": "API configuration found: prefix {prefix}",
  "ui_config_found": "UI configuration found: route {route}",
  "dependencies_found": "Dependencies found: {deps}",
  "provides_found": "Capabilities provided: {provides}",
  "invalid_manifest": "Invalid manifest for {module}: {errors}"
 },

 "queries": {
  "module_found": "Module found: {name}",
  "module_not_found": "Module not found: {name}",
  "endpoint_found": "Endpoint found: {method} {path}",
  "endpoint_not_found": "Endpoint not found: {method} {path}",
  "category_search": "Searching for modules in category: {category}",
  "capability_search": "Searching for modules providing: {capability}"
 },

 "dependencies": {
  "checking": "Checking dependencies for {module}",
  "resolved": "Dependencies resolved for {module}: {deps}",
  "missing": "Missing dependencies for {module}: {missing}",
  "circular": "Circular dependency detected: {cycle}",
  "satisfied": "All dependencies satisfied for {module}"
 },

 "export": {
  "openapi_generated": "OpenAPI specification generated with {endpoints} endpoints",
  "dependency_tree": "Dependency tree generated for {modules} modules",
  "stats_generated": "Registry statistics generated",
  "export_failed": "Error exporting data: {error}"
 },

 "stats": {
  "total_modules": "Total registered modules: {count}",
  "total_endpoints": "Total endpoints: {count}",
  "modules_with_api": "Modules with an API: {count}",
  "modules_with_ui": "Modules with a UI: {count}",
  "categories": "Available categories: {categories}",
  "capabilities": "Available capabilities: {capabilities}"
 }
}
