  "starting_module": "Starting module {module}...",
  "module_started": "Module {module} started successfully",
  "stopping_module": "Stopping module {module}...",
  "module_stopped": "Module {module} stopped successfully",
  "module_not_found": "Module {module} not found",
  "module_disabled": "Module {module} is disabled",
  "dependency_failed": "Failed to load dependency {dep} for {module}",
