  "stopping": "Deteniendo el módulo {module}...",
  "stopped": "Módulo {module} detenido correctamente",
  "error": "Error deteniendo {module}: {error}"
 },

 "lifecycle": {
  "loading_module": "Cargando el módulo {module}...",
  "module_loaded": "Módulo {module} cargado correctamente",
  "starting_module": "Iniciando el módulo {module}...",
