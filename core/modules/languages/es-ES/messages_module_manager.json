  "default": {
   "version": "1.0.0",
   "enabled": true
  },
  "keys": {
   "module": "module",
   "version": "version",
   "enabled": "enabled"
  }
 },

 "api": {
  "integration": {
   "failed": "Error integrando la API para {module}: {error}"
  },
  "removal": {
   "failed": "Error eliminando la API para {module}: {error}"
  },
  "integrator": {
   "set": "Integrador de API establecido para el gestor de módulos"
  }
 },

 "init": {
  "started": "ModuleManager inicializado",
  "config_loaded": "Configuración cargada desde {path}",
  "config_error": "Error cargando la configuración: {error}",
  "components_initialized": "Componentes especializados inicializados",
  "base_path_set": "Ruta base establecida: {path}"
 },

 "discovery": {
  "starting": "Descubriendo módulos...",
