{
 "_meta": {
  "component": "module_manager",
  "description": "Traducciones para el coordinador principal de módulos",
  "version": "1.0.0",
  "language": "es-ES"
 },

 "paths": {
  "manifests_dir": "manifests"
 },

 "files": {
  "manifest_toml": "manifest.toml",
  "module_manifest_format": "{module_name}.toml"
 },

