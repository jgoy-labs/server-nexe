root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = unset

[Makefile]
indent_style = tab

# Vendored / third-party files — don't enforce indentation rules
[LICENSE]
indent_size = unset

[public/ui/**]
indent_size = unset
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Build artifacts (vite output) — silenced via .editorconfig.
[dist/**]
indent_size = unset
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[scripts/poc-sidecar/__pycache__/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[src-tauri/gen/**]
end_of_line = unset
insert_final_newline = unset
