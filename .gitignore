# ===========================================
# .gitignore — server-nexe
#
# Excludes secrets, build artifacts, caches, runtime data
# and OS files from version control.
# ===========================================

# =====================
# Secrets
# =====================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cer
*.crt
*secret*
*credential*
*token*
!**/*token*.py
!**/*secret*.py

# =====================
# Binaries & build artifacts
# =====================
qdrant
nexe
dist/
build/
*.egg-info/
Install Nexe.app/
InstallNexe.app/
Nexe.app/
installer/swift-wizard/.build/

# Releases (DMGs/PKGs go to GitHub Releases, not the repo)
releases/
*.dmg
*.pkg

# =====================
# Runtime data
# =====================
storage/
!memory/memory/storage/
!tests/memory/memory/storage/
*.db
*.sqlite
*.log
logs/
.qdrant-initialized
snapshots/
plugins/web_ui_module/static/uploads/
plugins/web_ui_module/ui/uploads/
personality/.module_cache.json

# =====================
# Python
# =====================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
ENV/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*,cover
tmp/

# =====================
# Node
# =====================
node_modules/
package-lock.json

# =====================
# IDE & tooling caches
# =====================
.claude/
.ruff_cache/
*.code-workspace

# =====================
# OS
# =====================
.DS_Store
Thumbs.db

# =====================
# Accidental CLI artifacts (--output, --help)
# =====================
--output
--help
